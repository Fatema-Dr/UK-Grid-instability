    [Low Inertia Vulnerability], [OFF], [*ON*], [*ON*], [Flags insufficient grid momentum],
    [LGBM Quantile Risk ($>35%$)], [OFF], [OFF], [*ON*], [Lower quantile bound statistically breached],
